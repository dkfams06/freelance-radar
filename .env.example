# --- Dashboard (Next.js) -------------------------------------------------
# 브라우저 노출 가능한 값만 NEXT_PUBLIC_* 로. 현재 대시보드는 서버에서만 DB 접근하므로 선택 사항.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 대시보드 접근 보호 (Basic Auth). Vercel 배포 시 반드시 설정
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASSWORD=

# --- 서버 전용 (Collector + Dashboard 서버 코드) ---------------------------
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것

# migration 적용용 (pnpm db:migrate). Project Settings > Database > Connection string (URI)
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Collector -------------------------------------------------------------
# crawl_jobs polling 주기 (ms)
COLLECTOR_POLL_INTERVAL=5000
# worker 가 CHECK_NEW 를 자동 생성하는 주기 (분, 0 = 끔). OS cron 을 쓸 경우 0
COLLECTOR_SCHEDULE_NEW_MINUTES=10
# 백필 cutoff (이 시각 이후 등록된 프로젝트만)
COLLECTOR_BACKFILL_CUTOFF=2025-10-02T00:00:00+09:00
# 상세 조회 간 기본 지연 범위 (ms)
COLLECTOR_MIN_DELAY_MS=1500
COLLECTOR_MAX_DELAY_MS=3000
# debug | info | warn | error
COLLECTOR_LOG_LEVEL=info
# text | json
COLLECTOR_LOG_FORMAT=text

# --- Aside -----------------------------------------------------------------
# Aside CLI 경로 (기본: %LOCALAPPDATA%/Aside/CLI/current/aside.exe)
ASIDE_CLI_PATH=
# 여러 Aside 계정을 쓰는 경우 (예: u0, u1)
ASIDE_ACCOUNT=
# 1 이면 세션 만료 시 Aside 에이전트가 Aside 비밀번호 관리자에 저장된 자격증명으로 로그인 시도
# (CAPTCHA/OTP 는 우회하지 않고 LOGIN_REQUIRED 로 전환). 비밀번호는 이 프로젝트에 저장하지 않는다.
ASIDE_ASSISTED_LOGIN=0
# 1 이면 Collector 종료 시 작업 탭을 닫지 않음
ASIDE_KEEP_TABS=0

# --- Analyzer ----------------------------------------------------------------
# Anthropic API 키 (서버 전용)
ANTHROPIC_API_KEY=
# 분석 모델 (claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-4-5)
ANALYZER_MODEL=claude-opus-5-5
# low | medium | high (Haiku 4.5 는 무시)
ANALYZER_EFFORT=low
ANALYZER_MAX_TOKENS=8000
