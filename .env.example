# --- Dashboard (Next.js) -------------------------------------------------
# 브라우저 노출 가능한 값만 NEXT_PUBLIC_* 로. 현재 대시보드는 서버에서만 DB 접근하므로 선택 사항.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 대시보드 접근 보호 (Basic Auth). Vercel 배포 시 반드시 설정
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASSWORD=

# --- 서버 전용 (Collector + Dashboard 서버 코드) ---------------------------
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Collector -------------------------------------------------------------
# crawl_jobs polling 주기 (ms)
COLLECTOR_POLL_INTERVAL=5000
# worker 가 CHECK_NEW 를 자동 생성하는 주기 (분, 0 = 끔). OS cron 을 쓸 경우 0
COLLECTOR_SCHEDULE_NEW_MINUTES=10
# 백필 cutoff (이 시각 이후 등록된 프로젝트만)
COLLECTOR_BACKFILL_CUTOFF=2025-10-02T00:00:00+09:00
# 상세 조회 간 기본 지연 범위 (ms)
COLLECTOR_MIN_DELAY_MS=1500
COLLECTOR_MAX_DELAY_MS=3000
# debug | info | warn | error
COLLECTOR_LOG_LEVEL=info
# text | json
COLLECTOR_LOG_FORMAT=text

# --- 선택: 세션 만료 시 자동 로그인용 (DB 에 저장하지 않음) ---------------------
# 비워두면 자동 로그인을 시도하지 않고 LOGIN_REQUIRED 로 전환 → 사용자가 Aside 에서 직접 로그인
WISHKET_LOGIN_ID=
WISHKET_LOGIN_PASSWORD=
FREEMOA_LOGIN_ID=
FREEMOA_LOGIN_PASSWORD=
